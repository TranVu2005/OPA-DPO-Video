#!/bin/bash
# Step 4: reference log-probs + DPO. Variants (qsub -v, comma separated):
#   MASK=pixel|shuffle|reverse|freeze|tube|frame   distorted video m' (default pixel = paper)
#   PLAIN=1     plain DPO baseline: no OPA, reference = base, no token weights, no image-focus / anchor
#   BINARY=1    expert-free yes/no baseline on $OUT/work_binary (from prepare.sh): reference = base,
#               no token weights; keeps the image-focus term unless GAMMA_IF=0
#   GAMMA_IF=x  image-focus weight for BINARY runs (default 0.2, as the paper)
#   LR=x        BINARY learning rate (default 1e-5; pick on VH_VAL, e.g. 1e-5 vs 5e-5). BINARY runs use the
#               Adaptive-SEED student budget: LoRA r16/a32/dropout 0.05 on LM attention + merger,
#               cosine, warmup 5%, 1 epoch, batch 8. Output dir gets _lr<LR>.
#   MODEL=qwen25|qwen3|internvl  backbone (BINARY only for qwen3 / internvl). Output and reference dirs
#               get _qwen3 / _internvl, e.g. binary_dpo_lr1e-4_qwen3, work_binary/ref_logps_qwen3_base_pixel.
#
#   qsub scripts/gadi/train_dpo.pbs                           -> $OUT/opadpo_pixel
#   qsub -v MASK=shuffle scripts/gadi/train_dpo.pbs           -> $OUT/opadpo_shuffle
#   qsub -v PLAIN=1 scripts/gadi/train_dpo.pbs                -> $OUT/dpo_plain
#   qsub -v BINARY=1,GAMMA_IF=0,LR=1e-5 scripts/gadi/train_dpo.pbs    -> $OUT/binary_dpo_lr1e-5          ("DPO yes/no")
#   qsub -v BINARY=1,MASK=shuffle,LR=1e-5 scripts/gadi/train_dpo.pbs  -> $OUT/binary_dpo_shuffle_lr1e-5  ("DPO yes/no + m'")
#   qsub -v BINARY=1,FULL=1,GAMMA_IF=0,LR=1e-4,MODEL=qwen3 scripts/gadi/train_dpo.pbs -> $OUT/binary_dpo_lr1e-4_qwen3_full
#       (docs/unified_config.md: whole SEED TRAIN split, answer-token log-probs; run prepare_binary.sh first)
#   BETA=x      DPO beta for BINARY runs (default 0.1). A larger beta keeps the policy closer to the
#               reference (the base). Output dir gets _b<x> when BETA is not 0.1, e.g.
#   qsub -v BINARY=1,FULL=1,GAMMA_IF=0,LR=1e-4,BETA=0.5,MODEL=qwen3 ... -> $OUT/binary_dpo_lr1e-4_qwen3_full_b0.5
#PBS -N opadpo_dpo
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=160GB
#PBS -l jobfs=100GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/hn98+scratch/jp09+gdata/hn98
#PBS -l wd
#PBS -j oe
set -euo pipefail
source scripts/gadi/env.sh
# LORA=seed (default: LM attention + projector, docs/unified_config.md section 7) or
# LORA=language_attention (LM attention only, projector and vision frozen; output dir gets _lang_attn).
LORA=${LORA:-seed}
case $LORA in seed) LORA_TAG="" ;; language_attention) LORA_TAG=_lang_attn ;;
  *) echo "LORA must be seed or language_attention (got $LORA)" >&2; exit 1 ;; esac
MASK=${MASK:-pixel}
EPOCHS=4; GLOBAL_BATCH=32; HP=()
if [ -n "${BINARY:-}" ]; then
  WORK="$OUT/work_binary${FULL:+_all}"
  COMMON=(model.base_model="$BASE_MODEL" work_dir="$WORK")
  GAMMA_IF=${GAMMA_IF:-0.2}
  LR=${LR:-1e-5}; EPOCHS=1; GLOBAL_BATCH=8
  if [ "$GAMMA_IF" = 0 ]; then NAME=binary_dpo_lr$LR$MODEL_TAG; else NAME=binary_dpo_${MASK}_lr$LR$MODEL_TAG; fi
  BETA=${BETA:-0.1}; BETA_TAG=""
  if [ "$BETA" != 0.1 ]; then BETA_TAG=_b$BETA; fi
  NAME=$NAME${FULL:+_full}$LORA_TAG$BETA_TAG${SUFFIX:-}         # SUFFIX=_x: rerun into a fresh dir (an existing one resumes)
  ADAPTER=none; INIT=null; REF=ref_logps${MODEL_TAG}_base_$MASK
  EXTRA=(dpo.use_weights=false dpo.gamma_if="$GAMMA_IF" dpo.gamma_anc=0 dpo.beta="$BETA")
  HP=(model.lora_targets=$LORA model.lora_rank=16 model.lora_alpha=32 model.lora_dropout=0.05 train.warmup_ratio=0.05)
  # FULL=1: exactly docs/unified_config.md section 7 = the whole SEED TRAIN split (temporal +
  # object_relation, from prepare_binary.sh), log-probs of the answer token only, seed 0.
  # The flag also goes to precompute_ref (through COMMON), so the reference scores the same token.
  if [ -n "${FULL:-}" ]; then COMMON+=(train.answer_token_only=true); HP+=(train.seed=0); fi
  # Gradient checkpointing stays on for every backbone here: InternVL runs eager attention (no
  # flash-attn), and DPO's chosen + rejected pass without checkpointing ran out of the H200's 140GB
  # (SFT alone peaked at 122GB). Checkpointing recomputes the same forward: same loss, only slower.
elif [ "$MODEL" != qwen25 ]; then
  echo "MODEL=$MODEL supports only the yes/no baselines (BINARY=1); OPA-DPO needs the Qwen2.5 rollouts" >&2; exit 1
elif [ -n "${PLAIN:-}" ]; then
  NAME=dpo_plain; ADAPTER=none; INIT=null; REF=ref_logps_base_$MASK
  EXTRA=(dpo.use_weights=false dpo.gamma_if=0 dpo.gamma_anc=0)
else
  NAME=opadpo_$MASK; ADAPTER="$OUT/opa/final"; INIT="$ADAPTER"; REF=ref_logps_opa_$MASK
  EXTRA=()
fi
ARGS=("${COMMON[@]}" video.mask_method="$MASK" dpo.ref_dir="$REF")

# Computes the reference only when missing or made with other settings (e.g. other answer tokens).
python -m opadpo_video.precompute_ref --if_stale --adapter "$ADAPTER" "${ARGS[@]}"
python -m opadpo_video.train_dpo "${ARGS[@]}" "${EXTRA[@]}" "${HP[@]}" train.init_adapter="$INIT" \
  train.output_dir="$OUT/$NAME" train.num_train_epochs=$EPOCHS train.learning_rate=${LR:-1e-6} \
  train.per_device_train_batch_size=1 train.gradient_accumulation_steps=$((GLOBAL_BATCH / NGPUS))

bash scripts/gadi/archive.sh || true
