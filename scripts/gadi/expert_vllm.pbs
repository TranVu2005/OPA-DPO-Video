#!/bin/bash
# Step 2 + 2b fully offline: an open VLM served by vLLM on the same H200.
# Qwen2.5-VL-72B in bf16 (~144 GB) does not fit one H200 (141 GB): use the AWQ build (~40 GB).
# Needs a separate venv with vllm ($VLLM_VENV) and, on a login node:
#   HF_HOME=/scratch/hn98/$USER/hf_cache huggingface-cli download Qwen/Qwen2.5-VL-72B-Instruct-AWQ
# A weaker expert than GPT-4V gives noisier revisions: read some of $WORK/reports.jsonl.
#PBS -N opadpo_expert_vllm
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=160GB
#PBS -l jobfs=100GB
#PBS -l walltime=10:00:00
#PBS -l storage=scratch/hn98+scratch/jp09
#PBS -l wd
#PBS -j oe
set -euo pipefail
source scripts/gadi/env.sh
VLLM_VENV=${VLLM_VENV:-$S/venv_vllm}
# Older vLLM: --limit-mm-per-prompt image=16 ; newer: --limit-mm-per-prompt '{"image": 16}'
"$VLLM_VENV/bin/vllm" serve Qwen/Qwen2.5-VL-72B-Instruct-AWQ --served-model-name expert \
  --max-model-len 32768 --limit-mm-per-prompt image=16 --port 8000 > "$PBS_JOBFS/vllm.log" 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID"' EXIT
until curl -sf localhost:8000/v1/models > /dev/null; do sleep 10; done
python -m opadpo_video.expert "${COMMON[@]}" expert.base_url=http://localhost:8000/v1 \
  expert.model=expert expert.workers=16
python -m opadpo_video.build_dataset "${COMMON[@]}"
