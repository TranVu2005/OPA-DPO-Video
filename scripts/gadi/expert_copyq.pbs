#!/bin/bash
# Step 2 with a hosted API (GPT-4o / Gemini / Azure). copyq nodes have internet.
# Put the key in ~/.opadpo_key (chmod 600), never in this file.
#PBS -P ab12
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/ab12+scratch/ab12
#PBS -l wd
#PBS -j oe
set -euo pipefail
source scripts/gadi/env.sh
unset HF_HUB_OFFLINE TRANSFORMERS_OFFLINE
export OPENAI_API_KEY=$(cat ~/.opadpo_key)

python -m opadpo_video.expert work_dir=work expert.model=gpt-4o
python -m opadpo_video.build_dataset work_dir=work
