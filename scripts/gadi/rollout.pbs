#!/bin/bash
# Step 1: rollouts from the base policy. Resubmit to resume.
# Queue name / ncpus per GPU for the H200 nodes: check `nqstat` and the NCI Gadi queue docs.
#PBS -P ab12
#PBS -q gpuhopper
#PBS -l ngpus=4
#PBS -l ncpus=48
#PBS -l mem=480GB
#PBS -l jobfs=100GB
#PBS -l walltime=10:00:00
#PBS -l storage=gdata/ab12+scratch/ab12
#PBS -l wd
#PBS -j oe
set -euo pipefail
source scripts/gadi/env.sh

torchrun --standalone --nproc-per-node "$NGPUS" -m opadpo_video.rollout \
  --prompts data/prompts.jsonl model.base_model="$BASE_MODEL" work_dir=work
