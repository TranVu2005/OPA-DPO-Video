#!/bin/bash
# Step 3: OPA (LoRA-SFT on GT + revised). Global batch 128 (BINARY: 16) = NGPUS x 1 x accumulation.
#   qsub scripts/gadi/train_opa.pbs                -> $OUT/opa
#   qsub -v BINARY=1 scripts/gadi/train_opa.pbs    -> $OUT/binary_sft  (SFT on yes/no labels, no expert)
#PBS -N opadpo_opa
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=160GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/hn98+scratch/jp09+gdata/hn98
#PBS -l wd
#PBS -j oe
set -euo pipefail
source scripts/gadi/env.sh
NAME=opa
GLOBAL_BATCH=128
if [ -n "${BINARY:-}" ]; then
  COMMON=(model.base_model="$BASE_MODEL" work_dir="$OUT/work_binary")
  NAME=binary_sft
  GLOBAL_BATCH=16   # 130 yes/no examples: batch 128 gave 2 steps (1st at warmup lr 0); 16 -> ~16 steps, ~ binary DPO
fi
python -m opadpo_video.train_opa "${COMMON[@]}" train.output_dir="$OUT/$NAME" \
  train.num_train_epochs=2 train.learning_rate=2e-5 \
  train.per_device_train_batch_size=1 train.gradient_accumulation_steps=$((GLOBAL_BATCH / NGPUS))

bash scripts/gadi/archive.sh || true
