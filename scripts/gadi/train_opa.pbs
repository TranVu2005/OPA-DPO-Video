#!/bin/bash
# Step 3: OPA (LoRA-SFT on GT + revised). Global batch = NGPUS x 1 x accumulation.
#PBS -P ab12
#PBS -q gpuhopper
#PBS -l ngpus=4
#PBS -l ncpus=48
#PBS -l mem=480GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -l storage=gdata/ab12+scratch/ab12
#PBS -l wd
#PBS -j oe
set -euo pipefail
source scripts/gadi/env.sh

torchrun --standalone --nproc-per-node "$NGPUS" -m opadpo_video.train_opa \
  model.base_model="$BASE_MODEL" work_dir=work train.output_dir=runs/opa \
  train.num_train_epochs=2 train.learning_rate=2e-5 \
  train.per_device_train_batch_size=1 train.gradient_accumulation_steps=$((128 / NGPUS))
