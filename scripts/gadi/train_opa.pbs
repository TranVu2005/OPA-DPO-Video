#!/bin/bash
# Step 3: OPA (LoRA-SFT on GT + revised). Global batch 128 = NGPUS x 1 x accumulation.
# BINARY=1 uses the Adaptive-SEED student budget instead (src/seed_video/config.py, FAST=True):
#   LoRA r16/a32/dropout 0.05 on LM attention + merger, lr 1e-4 cosine, warmup 5%, 1 epoch, batch 8.
#   qsub scripts/gadi/train_opa.pbs                -> $OUT/opa
#   qsub -v BINARY=1 scripts/gadi/train_opa.pbs    -> $OUT/binary_sft  (SFT on yes/no labels, no expert)
#   qsub -v BINARY=1,MODEL=qwen3 scripts/gadi/train_opa.pbs     -> $OUT/binary_sft_qwen3
#   qsub -v BINARY=1,MODEL=internvl scripts/gadi/train_opa.pbs  -> $OUT/binary_sft_internvl
#   qsub -v BINARY=1,FULL=1,MODEL=qwen3 scripts/gadi/train_opa.pbs  -> $OUT/binary_sft_qwen3_full
#       (docs/unified_config.md: whole SEED TRAIN split, answer-token loss; run prepare_binary.sh first)
#   qsub -v BINARY=1,FULL=1,LORA=language_attention,MODEL=qwen3 ... -> $OUT/binary_sft_qwen3_full_lang_attn
#       (ablation: LoRA on LM attention only, projector frozen)
#   qsub -v BINARY=1,FULL=1,KL=1,MODEL=qwen3 scripts/gadi/train_opa.pbs -> $OUT/binary_sft_qwen3_full_kl1
#       (SFT anchored to the base: CE + KL * KL(student || base), as Adaptive-SEED's base anchor)
#PBS -N opadpo_opa
#PBS -P hn98
#PBS -q gpuhopper
#PBS -l ngpus=1
#PBS -l ncpus=12
#PBS -l mem=160GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -l storage=scratch/hn98+scratch/jp09+gdata/hn98
#PBS -l wd
#PBS -j oe
set -euo pipefail
source scripts/gadi/env.sh
# LORA=seed (default: LM attention + projector, docs/unified_config.md section 7) or
# LORA=language_attention (LM attention only, projector and vision frozen; output dir gets _lang_attn).
LORA=${LORA:-seed}
case $LORA in seed) LORA_TAG="" ;; language_attention) LORA_TAG=_lang_attn ;;
  *) echo "LORA must be seed or language_attention (got $LORA)" >&2; exit 1 ;; esac
NAME=opa; EPOCHS=2; LR=2e-5; GLOBAL_BATCH=128; HP=()
if [ -n "${BINARY:-}" ]; then
  COMMON=(model.base_model="$BASE_MODEL" work_dir="$OUT/work_binary${FULL:+_all}")
  # KL=x anchors SFT to the base (train.kl_to_base, needs FULL=1); the output dir gets _kl<x>.
  KL=${KL:-0}; KL_TAG=""
  if [ "$KL" != 0 ]; then
    [ -n "${FULL:-}" ] || { echo "KL needs FULL=1 (answer-token loss)" >&2; exit 1; }
    KL_TAG=_kl$KL
  fi
  NAME=binary_sft$MODEL_TAG${FULL:+_full}$LORA_TAG$KL_TAG; EPOCHS=1; LR=1e-4; GLOBAL_BATCH=8
  HP=(model.lora_targets=$LORA model.lora_rank=16 model.lora_alpha=32 model.lora_dropout=0.05 train.warmup_ratio=0.05
      train.kl_to_base=$KL)
  # FULL=1: exactly docs/unified_config.md section 7 = the whole SEED TRAIN split (temporal +
  # object_relation, from prepare_binary.sh), loss on the answer token only, seed 0.
  if [ -n "${FULL:-}" ]; then HP+=(train.answer_token_only=true train.seed=0); fi
  # InternVL's remote code is trained without checkpointing, as SEED (FAST: grad_ckpt=False); fits one H200.
  if [ "$MODEL" = internvl ]; then HP+=(model.gradient_checkpointing=false); fi
elif [ "$MODEL" != qwen25 ]; then
  echo "MODEL=$MODEL supports only the yes/no baselines (BINARY=1); OPA needs the Qwen2.5 rollouts" >&2; exit 1
fi
python -m opadpo_video.train_opa "${COMMON[@]}" "${HP[@]}" train.output_dir="$OUT/$NAME" \
  train.num_train_epochs=$EPOCHS train.learning_rate=$LR \
  train.per_device_train_batch_size=1 train.gradient_accumulation_steps=$((GLOBAL_BATCH / NGPUS))
bash scripts/gadi/archive.sh || true
